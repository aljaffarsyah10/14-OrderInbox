# Application
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/orderinbox?schema=public

# Cache & Queue (Redis)
REDIS_URL=redis://localhost:6379

# Authentication (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Notifications (Email)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=notifications@orderinbox.local
