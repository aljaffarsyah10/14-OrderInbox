{
    # Global ACME configuration
    email {$ACME_EMAIL:admin@orderinbox.com}
    admin off
}

# Production Domain Site Block
{$DOMAIN_NAME:localhost} {
    # Reverse proxy to Next.js App service
    reverse_proxy app:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Compression
    encode zstd gzip

    # Request body size limit (Protection against volumetric payload attacks)
    request_body {
        max_size 10MB
    }

    # Production Hardened Security Headers
    header {
        # HTTP Strict Transport Security (HSTS) - 1 year with preload
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Prevent clickjacking attacks
        X-Frame-Options "DENY"

        # Prevent MIME type sniffing
        X-Content-Type-Options "nosniff"

        # Referrer Policy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Restrict browser capabilities & APIs
        Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()"

        # Content Security Policy (allows Next.js runtime hydration while securing external assets)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'none';"

        # Remove Caddy / server fingerprinting banner
        -Server
    }

    # Access & Error Logging (Structured JSON for Log Analyzers)
    log {
        output stdout
        format json
        level INFO
    }
}
